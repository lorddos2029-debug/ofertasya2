{
  "buildCommand": "node build.mjs",
  "outputDirectory": "public",
  "functions": {
    "api/handler.mjs": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/handler?route=:path*"
    },
    {
      "source": "/checkout",
      "destination": "/checkout.html"
    },
    {
      "source": "/checkout/",
      "destination": "/checkout.html"
    },
    {
      "source": "/camera",
      "destination": "/camera.html"
    },
    {
      "source": "/camera/",
      "destination": "/camera.html"
    },
    {
      "source": "/capacete",
      "destination": "/capacete.html"
    },
    {
      "source": "/capacete/",
      "destination": "/capacete.html"
    },
    {
      "source": "/basike",
      "destination": "/basike.html"
    },
    {
      "source": "/basike/",
      "destination": "/basike.html"
    },
    {
      "source": "/travesseiro",
      "destination": "/travesseiro.html"
    },
    {
      "source": "/travesseiro/",
      "destination": "/travesseiro.html"
    }
  ],
  "headers": [
    {
      "source": "/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Referrer-Policy",
          "value": "same-origin"
        }
      ]
    }
  ]
}
