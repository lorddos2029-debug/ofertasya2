{
  "buildCommand": "node build.mjs",
  "outputDirectory": "public",
  "functions": {
    "api/handler.mjs": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/handler?route=:path*"
    },
    {
      "source": "/checkout",
      "destination": "/checkout.html"
    },
    {
      "source": "/checkout/",
      "destination": "/checkout.html"
    },
    {
      "source": "/camera",
      "destination": "/camera.html"
    },
    {
      "source": "/camera/",
      "destination": "/camera.html"
    },
    {
      "source": "/capacete",
      "destination": "/capacete.html"
    },
    {
      "source": "/capacete/",
      "destination": "/capacete.html"
    },
    {
      "source": "/basike",
      "destination": "/basike.html"
    },
    {
      "source": "/basike/",
      "destination": "/basike.html"
    },
    {
      "source": "/travesseiro",
      "destination": "/travesseiro.html"
    },
    {
      "source": "/travesseiro/",
      "destination": "/travesseiro.html"
    },
    {
      "source": "/robo",
      "destination": "/robo.html"
    },
    {
      "source": "/robo/",
      "destination": "/robo.html"
    },
    {
      "source": "/relogio",
      "destination": "/relogio.html"
    },
    {
      "source": "/relogio/",
      "destination": "/relogio.html"
    },
    {
      "source": "/climatizador",
      "destination": "/climatizador.html"
    },
    {
      "source": "/climatizador/",
      "destination": "/climatizador.html"
    },
    {
      "source": "/ventilador",
      "destination": "/ventilador.html"
    },
    {
      "source": "/ventilador/",
      "destination": "/ventilador.html"
    },
    {
      "source": "/trocas-e-devolucoes",
      "destination": "/info-trocas-e-devolucoes.html"
    },
    {
      "source": "/trocas-e-devolucoes/",
      "destination": "/info-trocas-e-devolucoes.html"
    },
    {
      "source": "/politica-de-privacidade",
      "destination": "/info-politica-de-privacidade.html"
    },
    {
      "source": "/politica-de-privacidade/",
      "destination": "/info-politica-de-privacidade.html"
    },
    {
      "source": "/perguntas-frequentes",
      "destination": "/info-perguntas-frequentes.html"
    },
    {
      "source": "/perguntas-frequentes/",
      "destination": "/info-perguntas-frequentes.html"
    },
    {
      "source": "/acompanhar-pedido",
      "destination": "/info-acompanhar-pedido.html"
    },
    {
      "source": "/acompanhar-pedido/",
      "destination": "/info-acompanhar-pedido.html"
    },
    {
      "source": "/sobre-nos",
      "destination": "/info-sobre-nos.html"
    },
    {
      "source": "/sobre-nos/",
      "destination": "/info-sobre-nos.html"
    },
    {
      "source": "/nossas-lojas",
      "destination": "/info-nossas-lojas.html"
    },
    {
      "source": "/nossas-lojas/",
      "destination": "/info-nossas-lojas.html"
    },
    {
      "source": "/trabalhe-conosco",
      "destination": "/info-trabalhe-conosco.html"
    },
    {
      "source": "/trabalhe-conosco/",
      "destination": "/info-trabalhe-conosco.html"
    },
    {
      "source": "/atendimento",
      "destination": "/info-atendimento.html"
    },
    {
      "source": "/atendimento/",
      "destination": "/info-atendimento.html"
    },
    {
      "source": "/whatsapp",
      "destination": "/info-whatsapp.html"
    },
    {
      "source": "/whatsapp/",
      "destination": "/info-whatsapp.html"
    },
    {
      "source": "/mapa-do-site",
      "destination": "/info-mapa-do-site.html"
    },
    {
      "source": "/mapa-do-site/",
      "destination": "/info-mapa-do-site.html"
    },
    {
      "source": "/fale-conosco",
      "destination": "/info-atendimento.html"
    },
    {
      "source": "/fale-conosco/",
      "destination": "/info-atendimento.html"
    },
    {
      "source": "/panela",
      "destination": "/panela.html"
    },
    {
      "source": "/panela/",
      "destination": "/panela.html"
    },
    {
      "source": "/purificador",
      "destination": "/purificador.html"
    },
    {
      "source": "/purificador/",
      "destination": "/purificador.html"
    }
  ],
  "headers": [
    {
      "source": "/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Referrer-Policy",
          "value": "same-origin"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/relogio",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/relogio/",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/relogio.html",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/camera",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/camera/",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/camera.html",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/capacete",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/capacete/",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/capacete.html",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/basike",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/basike/",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/basike.html",
      "destination": "/",
      "permanent": false
    }
  ]
}
